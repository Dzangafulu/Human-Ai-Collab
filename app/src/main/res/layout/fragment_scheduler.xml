<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F6FB">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <TextView android:id="@+id/schedulerBack" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:text="‹  Back to dashboard" android:textColor="#2D6FFF" android:textSize="16sp" android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Study scheduler" android:textSize="25sp" android:textColor="#1D2938" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plan your week around upcoming tasks" android:textSize="13sp" android:textColor="#667791" android:layout_marginBottom="17dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/dashboard_white_card" android:padding="18dp" android:layout_marginBottom="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sessions per day" android:textColor="#17324F" android:textStyle="bold" />
      <Spinner android:id="@+id/schedulerSessions" android:layout_width="match_parent" android:layout_height="52dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start study sessions at" android:textColor="#17324F" android:textStyle="bold" android:layout_marginTop="12dp" />
      <Spinner android:id="@+id/schedulerHours" android:layout_width="match_parent" android:layout_height="52dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Each task gets one 60-minute session in the next 7 days. Earlier deadlines are scheduled first." android:textSize="12sp" android:textColor="#667791" android:layout_marginTop="6dp" />
    </LinearLayout>
    <Button android:id="@+id/schedulerGenerate" android:layout_width="match_parent" android:layout_height="55dp" android:text="Generate study plan" android:textAllCaps="false" android:backgroundTint="#2D6FFF" android:textColor="#FFFFFF" />
    <Button android:id="@+id/schedulerSave" android:layout_width="match_parent" android:layout_height="52dp" android:text="Save plan to Firebase" android:textAllCaps="false" android:enabled="false" android:backgroundTint="#2AB987" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/schedulerInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Generate a study plan to begin." android:textSize="13sp" android:textColor="#667791" android:layout_marginBottom="10dp" />
    <LinearLayout android:id="@+id/schedulerList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
