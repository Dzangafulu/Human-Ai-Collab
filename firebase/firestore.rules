rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isGroupMember(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid))
        && me() in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }
    function isContact(cid) {
      return signedIn() && exists(/databases/$(database)/documents/connections/$(cid))
        && me() in get(/databases/$(database)/documents/connections/$(cid)).data.memberUids;
    }
    match /users/{userId} {
      // Exact-email lookup requires a constrained list query. It is NOT a private directory.
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 1;
      allow create: if signedIn() && me() == userId
                    && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && me() == userId
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /chat_requests/{requestId} {
      allow get, list: if signedIn() && (resource.data.senderUid == me() || resource.data.receiverUid == me());
      allow create: if signedIn() && request.resource.data.senderUid == me()
          && request.resource.data.receiverUid != me()
          && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverUid))
          && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.receiverUid == me()
          && resource.data.status == 'pending'
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.receiverUid == resource.data.receiverUid
          && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }
    match /connections/{connectionId} {
      allow get, list: if signedIn() && me() in resource.data.memberUids;
      allow create: if signedIn()
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids[0] == me()
          && exists(/databases/$(database)/documents/chat_requests/$(request.resource.data.memberUids[1] + '_' + me()))
          && get(/databases/$(database)/documents/chat_requests/$(request.resource.data.memberUids[1] + '_' + me())).data.status == 'pending';
      allow update, delete: if false;
      match /read_receipts/{readerUid} {
        allow read: if isContact(connectionId) && readerUid == me();
        allow create, update: if isContact(connectionId) && readerUid == me()
          && request.resource.data.uid == me()
          && request.resource.data.lastReadAt is number;
        allow delete: if false;
      }
      match /messages/{msgId} {
        allow read: if isContact(connectionId);
        allow create: if isContact(connectionId)
          && request.resource.data.senderUid == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (!('attachmentBase64' in request.resource.data)
            || (request.resource.data.attachmentBase64 is string
                && request.resource.data.attachmentBase64.size() <= 345000
                && request.resource.data.attachmentName is string
                && request.resource.data.attachmentMime is string));
        allow update, delete: if false;
      }
    }
    match /groups/{groupId} {
      allow get, list: if signedIn() && me() in resource.data.memberUids;
      allow create: if signedIn()
          && request.resource.data.ownerUid == me()
          && request.resource.data.memberUids is list
          && me() in request.resource.data.memberUids
          && request.resource.data.memberUids.size() >= 2
          && request.resource.data.memberUids.size() <= 20;
      allow update: if isGroupMember(groupId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() <= 20;
      allow delete: if signedIn() && resource.data.ownerUid == me();
      match /read_receipts/{readerUid} {
        allow read: if isGroupMember(groupId) && readerUid == me();
        allow create, update: if isGroupMember(groupId) && readerUid == me()
          && request.resource.data.uid == me()
          && request.resource.data.lastReadAt is number;
        allow delete: if false;
      }
      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderUid == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && (!('attachmentBase64' in request.resource.data)
            || (request.resource.data.attachmentBase64 is string
                && request.resource.data.attachmentBase64.size() <= 345000
                && request.resource.data.attachmentName is string
                && request.resource.data.attachmentMime is string));
        allow update, delete: if false;
      }
    }
    match /tasks/{taskId} {
      function personalOwner() { return resource.data.ownerUid == me(); }
      function canSee() { return signedIn() && (
        personalOwner() || resource.data.assigneeUid == me()
        || (resource.data.groupId != '' && isGroupMember(resource.data.groupId))); }
      allow get, list: if canSee();
      allow create: if signedIn() && request.resource.data.ownerUid == me()
        && ((request.resource.data.groupId == '' && request.resource.data.assigneeUid == me())
         || (request.resource.data.groupId != ''
             && isGroupMember(request.resource.data.groupId)
             && request.resource.data.assigneeUid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids));
      allow update: if canSee()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.groupId == resource.data.groupId
        && (
             (resource.data.ownerUid == me() && (
                (resource.data.groupId == '' && request.resource.data.assigneeUid == resource.data.assigneeUid)
                || (resource.data.groupId != '' && isGroupMember(resource.data.groupId)
                    && request.resource.data.assigneeUid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids)
             ))
             || (resource.data.assigneeUid == me()
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progressPercent']))
        );
      allow delete: if canSee() && personalOwner();
    }
    match /study_sessions/{sid} {
      allow read, delete: if signedIn() && resource.data.ownerUid == me();
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update: if signedIn() && resource.data.ownerUid == me()
         && request.resource.data.ownerUid == me();
    }
    match /notes/{uid}/myNotes/{noteId} {
      allow read, write: if signedIn() && me() == uid;
    }
  }
}
